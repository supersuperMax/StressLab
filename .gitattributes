# Deterministic files: LF in the repository and in every working copy (CLAUDE.md, rule 6).
* text=auto eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf

*.png binary
*.jpg binary
*.ico binary
*.icns binary
*.h5 binary
*.hdf5 binary
*.zst binary
*.slpack binary

# Input files of the import tests in other encodings and with other line breaks (task 3.2).
tests/data/inp/bytes/** binary

# Blocks of bulk data in project folders (.fem/objects): bytes hashed as they are.
**/.fem/objects/** binary
