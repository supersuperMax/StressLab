# Builds string catalogs (JSON files named by language, like ru.json) into a C++ source file, so
# the core has its translations without files next to the executable (headless runs, tests).
# Bytes go in as arrays rather than string literals: MSVC limits the length of a literal.
#
#   fem_embed_catalogs(<output.cpp> <catalog.json>...)
#
# The output defines `fem::l10n::detail::core_catalogs()` (core/src/l10n/core_catalogs.h).
# Editing a catalog reconfigures the project, which regenerates the file.
function(fem_embed_catalogs output)
    set(arrays "")
    set(entries "")
    set(index 0)
    foreach(catalog IN LISTS ARGN)
        get_filename_component(language "${catalog}" NAME_WE)
        file(READ "${catalog}" hex HEX)
        string(LENGTH "${hex}" hex_length)
        math(EXPR size "${hex_length} / 2")
        string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
        string(APPEND arrays "constexpr unsigned char catalog_${index}[] = {${bytes}};\n")
        string(APPEND entries "        {\"${language}\",\n")
        string(APPEND entries
               "         {reinterpret_cast<const char*>(catalog_${index}), ${size}}},\n")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${catalog}")
        math(EXPR index "${index} + 1")
    endforeach()
    # Appended piece by piece: the arrays contain ';', which a CMake list would split on.
    set(content "// Generated by cmake/EmbedCatalogs.cmake from core/l10n/*.json; do not edit.\n")
    string(APPEND content "#include \"l10n/core_catalogs.h\"\n\n#include <array>\n\n")
    string(APPEND content "namespace fem::l10n::detail {\n\nnamespace {\n\n${arrays}\n")
    string(APPEND content "}  // namespace\n\n")
    string(APPEND content "std::span<const EmbeddedCatalog> core_catalogs() {\n")
    string(APPEND content "    static const std::array<EmbeddedCatalog, ${index}> catalogs{{\n")
    string(APPEND content "${entries}    }};\n    return catalogs;\n}\n\n")
    string(APPEND content "}  // namespace fem::l10n::detail\n")
    file(CONFIGURE OUTPUT "${output}" CONTENT "${content}" @ONLY)
endfunction()
